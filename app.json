{
  "expo": {
    "name": "WEYRA",
    "slug": "weyra",
    "scheme": "weyra",
    "version": "1.0.0",
    "icon": "./assets/branding/icon.png",
    "splash": {
      "image": "./assets/branding/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F1E9"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "WEYRA accesses only the photos you choose for your wardrobe and virtual try-on.",
          "cameraPermission": "WEYRA uses the camera only when you choose to photograph a wardrobe item.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1E9",
          "image": "./assets/branding/weyra-logo.png",
          "resizeMode": "contain",
          "imageWidth": 220
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.weyra.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.weyra.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "monochromeImage": "./assets/branding/adaptive-icon-monochrome.png",
        "backgroundColor": "#F6F1E9"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    }
  }
}
