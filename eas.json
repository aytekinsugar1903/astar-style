{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "true",
        "EXPO_PUBLIC_PREMIUM_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

