EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never place service-role, AI, payment, catalog-feed, or virtual try-on secrets in EXPO_PUBLIC_* variables.
#
# The following names are Supabase Edge Function secrets, not mobile .env values.
# Defaults remain mock/off unless both provider selection and enable switches are set server-side:
# PAID_PROVIDERS_ENABLED=false
# TRY_ON_PROVIDER=mock
# FASHN_API_KEY=
# FASHN_ESTIMATED_COST_USD=
# GARMENT_ANALYSIS_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=
# OPENAI_VISION_ESTIMATED_COST_USD=
# CATALOG_PROVIDER=mock
# OFFICIAL_CATALOG_ENABLED=false
# CATALOG_FEED_URL=
# CATALOG_FEED_TOKEN=
# CATALOG_SOURCE_NAME=
